  <Source><DataSourceViewID>Mini Red DW</DataSourceViewID></Source>
  <MdxScripts><MdxScript><ID>MdxScript</ID><Name>MdxScript</Name><Commands><Command><Text>CALCULATE;

CREATE MEMBER CURRENTCUBE.[Measures].[Tasa de Quiebre]
 AS IIF([Measures].[Observaciones] = 0, NULL, [Measures].[Es Quiebre] / [Measures].[Observaciones]),
 FORMAT_STRING = "Percent", ASSOCIATED_MEASURE_GROUP = 'Stock';

CREATE MEMBER CURRENTCUBE.[Measures].[Tasa Bajo Minimo]
 AS IIF([Measures].[Observaciones] = 0, NULL, [Measures].[Es Bajo Minimo] / [Measures].[Observaciones]),
 FORMAT_STRING = "Percent", ASSOCIATED_MEASURE_GROUP = 'Stock';

CREATE MEMBER CURRENTCUBE.[Measures].[Dias de Cobertura]
 AS IIF([Measures].[Cantidad Vendida Stock] = 0, NULL, [Measures].[Stock Suma Tecnica] / [Measures].[Cantidad Vendida Stock]),
 FORMAT_STRING = "0.00", ASSOCIATED_MEASURE_GROUP = 'Stock';

CREATE MEMBER CURRENTCUBE.[Measures].[Ticket Promedio]
 AS IIF([Measures].[Tickets] = 0, NULL, [Measures].[Importe Total] / [Measures].[Tickets]),
 FORMAT_STRING = "Currency", ASSOCIATED_MEASURE_GROUP = 'Ventas';</Text></Command></Commands></MdxScript></MdxScripts>
